/* ═══════════════════════════════════════════
   The-Eye TUI — Main stylesheet
   Phong cách: dark terminal, Claude Code-like
   ═══════════════════════════════════════════ */

/* Global */
Screen {
    background: $background;
}

Header {
    background: #1a1a2e;
    color: #7c83fd;
    height: 1;
    dock: top;
}

Footer {
    background: #1a1a2e;
    color: #555577;
    height: 1;
    dock: bottom;
}

/* ── Main layout ── */
#main-layout {
    height: 1fr;
}

/* ── Sidebar ── */
Sidebar {
    width: 22;
    min-width: 22;
    background: #12121f;
    border-right: tall #2a2a4a;
    padding: 0 1;
}

Sidebar.hidden {
    display: none;
}

.sidebar-section-title {
    color: #555577;
    text-style: bold;
    padding: 1 0 0 0;
    margin-bottom: 0;
}

.sidebar-divider {
    color: #2a2a4a;
    height: 1;
}

.company-item {
    color: #c0c0d0;
    padding: 0 1;
    height: 1;
}

.company-item:hover {
    background: #2a2a4a;
    color: #ffffff;
}

.company-item.selected {
    background: #3a3a6a;
    color: #7c83fd;
    text-style: bold;
}

.sentiment-filter-item {
    padding: 0 1;
    height: 1;
}

.filter-all   { color: #aaaacc; }
.filter-pos   { color: #4ecca3; }
.filter-neg   { color: #ff6b6b; }
.filter-neu   { color: #888899; }

.filter-pos.active, .filter-neg.active, .filter-neu.active, .filter-all.active {
    text-style: bold reverse;
}

/* ── Content area ── */
#content-area {
    width: 1fr;
    background: #0d0d1a;
}

/* ── Stat bar ── */
StatBar {
    height: 3;
    background: #12121f;
    border-bottom: tall #2a2a4a;
    padding: 0 2;
    layout: horizontal;
    align: left middle;
}

.stat-item {
    margin-right: 3;
    color: #888899;
}

.stat-value {
    color: #7c83fd;
    text-style: bold;
}

.stat-pos { color: #4ecca3; text-style: bold; }
.stat-neg { color: #ff6b6b; text-style: bold; }
.stat-neu { color: #888899; }

.stat-separator {
    color: #2a2a4a;
    margin: 0 1;
}

.live-badge {
    color: #4ecca3;
    text-style: bold;
    margin-left: 2;
}

/* ── Article table ── */
ArticleTable {
    height: 1fr;
    background: #0d0d1a;
}

DataTable {
    background: #0d0d1a;
    color: #c0c0d0;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #1a1a2e;
    color: #7c83fd;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #2a2a4a;
    color: #ffffff;
}

DataTable > .datatable--hover {
    background: #1e1e34;
}

/* Row coloring by sentiment */
.row-pos { color: #4ecca3; }
.row-neg { color: #ff6b6b; }
.row-neu { color: #888899; }

/* ── Article detail screen ── */
ArticleDetailScreen {
    background: #0d0d1a;
    align: center middle;
}

#detail-container {
    width: 90%;
    max-width: 120;
    height: 85%;
    background: #12121f;
    border: round #3a3a6a;
    padding: 1 2;
}

#detail-title {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 1;
    padding: 0 0 1 0;
    border-bottom: dashed #2a2a4a;
}

#detail-meta {
    color: #7c83fd;
    margin-bottom: 1;
}

#detail-sentiment {
    margin-bottom: 1;
}

#detail-summary {
    color: #c0c0d0;
    height: 1fr;
    overflow-y: auto;
    border: dashed #2a2a4a;
    padding: 1;
}

#detail-url {
    color: #555577;
    margin-top: 1;
}

/* ── Config screen ── */
ConfigScreen {
    background: #0d0d1a;
    align: center middle;
}

#config-container {
    width: 80%;
    max-width: 100;
    height: 80%;
    background: #12121f;
    border: round #3a3a6a;
    padding: 1 2;
}

.config-section {
    color: #7c83fd;
    text-style: bold;
    margin: 1 0 0 0;
    border-bottom: solid #2a2a4a;
}

.config-key   { color: #555577; }
.config-value { color: #4ecca3; }
.config-null  { color: #ff6b6b; }

/* ── Log screen ── */
LogScreen {
    background: #0d0d1a;
    align: center middle;
}

#log-container {
    width: 90%;
    height: 85%;
    background: #12121f;
    border: round #3a3a6a;
    padding: 1 2;
}

Log {
    background: #0d0d1a;
    color: #888899;
    height: 1fr;
}

/* ── Notifications ── */
Toast {
    background: #1a1a2e;
    color: #c0c0d0;
}
